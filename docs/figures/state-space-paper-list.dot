  labelloc=t;
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, margin="0.06,0.04"];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  S0 [label="P:[] A:[] B:[]", fillcolor="#d5f0d9", peripheries=2];
